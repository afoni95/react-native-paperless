{
  "expo": {
    "name": "Paperless Native",
    "slug": "react-native-paperless",
    "version": "1.3.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#17541f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.paperlessnative.mobile"
    },
    "android": {
      "versionCode": 18,
      "adaptiveIcon": {
        "backgroundColor": "#62c1f0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.paperlessnative.mobile",
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withAndroidSigning",
      "./plugins/withGradleProperties",
      "./plugins/withDependenciesInfo",
      [
        "./plugins/withJscFlavor",
        {
          "version": "2026004.0"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": true,
            "usesCleartextTraffic": true,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "abiFilters": [
              "arm64-v8a"
            ]
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Paperless to access your photos to upload documents.",
          "cameraPermission": "Allow Paperless to access your camera to scan documents.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store"
    ]
  }
}